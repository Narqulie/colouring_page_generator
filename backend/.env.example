REPLICATE_API_TOKEN=your_token_here

# Server-authoritative time-based theme (IANA timezone).
# Every client receives this shared schedule; there are no client preferences.
THEME_TIMEZONE=Europe/Helsinki

# R2 storage (optional — local filesystem fallback)
# R2_BUCKET=colouringpages
# R2_ACCESS_KEY=your_access_key
# R2_SECRET_KEY=your_secret_key
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
